{
  "$id": "https://example.invalid/customs-ai-agent/trade-document-evaluation-splits-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "trade-document-evaluation-splits/v2"
    },
    "dataset_id": {
      "const": "trade_document_triplets"
    },
    "dataset_version": {
      "const": "source-v1"
    },
    "evaluation_version": {
      "const": "evaluation-v2"
    },
    "strategy": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "compromised_holdout_replacement"
        },
        "version": {
          "const": "v2"
        },
        "holdout_seed": {
          "minLength": 1,
          "type": "string"
        },
        "rebalance_seed": {
          "minLength": 1,
          "type": "string"
        },
        "unit": {
          "const": "case_id"
        },
        "replacement_pool": {
          "const": "legacy_development_plus_validation_only"
        },
        "variant_co_location_required": {
          "const": true
        }
      },
      "required": [
        "name",
        "version",
        "holdout_seed",
        "rebalance_seed",
        "unit",
        "replacement_pool",
        "variant_co_location_required"
      ],
      "type": "object"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "development": {
          "const": 60
        },
        "validation": {
          "const": 20
        },
        "locked_test": {
          "const": 20
        }
      },
      "required": [
        "development",
        "validation",
        "locked_test"
      ],
      "type": "object"
    },
    "assignments_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "splits": {
      "$ref": "#/$defs/splits"
    },
    "legacy": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "trade-document-triplets-splits/v1"
        },
        "assignments_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "splits": {
          "$ref": "#/$defs/splits"
        },
        "holdout_status": {
          "const": "holdout_compromised_by_precommit_evaluation"
        },
        "invalidated_evaluation_ids": {
          "contains": {
            "const": "EVAL-0003"
          },
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "former_locked_use": {
          "const": "development_or_validation_only"
        }
      },
      "required": [
        "schema_version",
        "assignments_sha256",
        "document_sha256",
        "splits",
        "holdout_status",
        "invalidated_evaluation_ids",
        "former_locked_use"
      ],
      "type": "object"
    },
    "holdout_policy": {
      "additionalProperties": false,
      "properties": {
        "release_eligible": {
          "const": false
        },
        "release_status": {
          "const": "release_holdout_v2_publicly_derivable"
        },
        "allowed_use": {
          "const": "development_diagnostic_only"
        },
        "controlled_mutation_generation_allowed_before_release": {
          "const": false
        },
        "model_or_rule_tuning_allowed": {
          "const": false
        },
        "replacement_protocol": {
          "const": "sealed-release-holdout-bundle-manifest/v1"
        }
      },
      "required": [
        "release_eligible",
        "release_status",
        "allowed_use",
        "controlled_mutation_generation_allowed_before_release",
        "model_or_rule_tuning_allowed",
        "replacement_protocol"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "evaluation_version",
    "strategy",
    "counts",
    "assignments_sha256",
    "splits",
    "legacy",
    "holdout_policy"
  ],
  "$defs": {
    "case_ids_20": {
      "items": {
        "pattern": "^trade-triplet-[0-9]{4}$",
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 20,
      "type": "array",
      "uniqueItems": true
    },
    "case_ids_60": {
      "items": {
        "pattern": "^trade-triplet-[0-9]{4}$",
        "type": "string"
      },
      "maxItems": 60,
      "minItems": 60,
      "type": "array",
      "uniqueItems": true
    },
    "splits": {
      "additionalProperties": false,
      "properties": {
        "development": {
          "$ref": "#/$defs/case_ids_60"
        },
        "validation": {
          "$ref": "#/$defs/case_ids_20"
        },
        "locked_test": {
          "$ref": "#/$defs/case_ids_20"
        }
      },
      "required": [
        "development",
        "validation",
        "locked_test"
      ],
      "type": "object"
    }
  },
  "title": "Evaluation-v2 split with compromised-holdout history",
  "type": "object"
}
