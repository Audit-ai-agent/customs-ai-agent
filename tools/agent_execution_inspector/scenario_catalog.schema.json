{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/customs-ai-agent/agent-execution-inspector-scenarios-v1.schema.json",
  "title": "Agent Execution Inspector synthetic scenario catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_title",
    "catalog_notice",
    "expectation_disclaimer",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-execution-inspector-scenarios/v1"
    },
    "catalog_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "catalog_notice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expectation_disclaimer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "requirement_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "filename",
        "declared_type",
        "content_text"
      ],
      "properties": {
        "document_id": {
          "$ref": "#/$defs/identifier"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\:\\s\\u0000-\\u001f\\u007f](?:[^/\\\\:\\u0000-\\u001f\\u007f]*[^/\\\\:\\s\\u0000-\\u001f\\u007f])?$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "declared_type": {
          "enum": [
            "invoice",
            "packing_list",
            "bill_of_lading",
            "certificate_of_origin",
            "unknown"
          ]
        },
        "content_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        }
      }
    },
    "expected_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_status",
        "assessment",
        "review_disposition",
        "assurance_level",
        "retrieval_status",
        "retrieval_coverage",
        "validation_issue_count",
        "finding_count",
        "mock_fallback_count"
      ],
      "properties": {
        "schema_version": {"const": "3.0"},
        "execution_status": {"enum": ["succeeded", "partial", "failed"]},
        "assessment": {"enum": ["no_issue_detected", "issues_detected", "indeterminate"]},
        "review_disposition": {"enum": ["auto_review_complete", "human_review_required", "blocked"]},
        "assurance_level": {"enum": ["diagnostic", "production_candidate", "production"]},
        "retrieval_status": {"enum": ["ok", "partial", "failed"]},
        "retrieval_coverage": {"enum": ["complete", "partial", "unknown"]},
        "validation_issue_count": {"type": "integer", "minimum": 0},
        "finding_count": {"type": "integer", "minimum": 0},
        "mock_fallback_count": {"const": 0}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "title",
        "category",
        "purpose",
        "injected_variation",
        "expected_checkpoint",
        "case_id",
        "trade_type",
        "document_language",
        "uploaded_requirement_document_codes",
        "documents"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "enum": [
            "baseline",
            "regulatory",
            "consistency",
            "fail_closed",
            "safety"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "injected_variation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "expected_checkpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "case_id": {
          "$ref": "#/$defs/identifier"
        },
        "trade_type": {
          "enum": [
            "import",
            "export"
          ]
        },
        "document_language": {
          "enum": ["ko", "en"]
        },
        "uploaded_requirement_document_codes": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirement_code"
          }
        },
        "supporting_documents": {
          "type": "array",
          "maxItems": 10,
          "items": {"type": "object"}
        },
        "expected_assertions": {
          "$ref": "#/$defs/expected_assertions"
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/document"
          }
        }
      }
    }
  }
}
