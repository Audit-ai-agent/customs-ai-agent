{
  "$id": "https://schemas.customs.local/agent/v3/raster-text-extraction-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Required metadata for one raw local OCR text-draft request. The HTTP body is original PDF/JPEG/PNG bytes; it is never base64-embedded in JSON or forwarded to text review.",
  "properties": {
    "document_asset_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "extraction_request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "media_type": {"type": "string", "enum": ["application/pdf", "image/jpeg", "image/png"]},
    "raster_text_profile_revision": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
  },
  "required": ["document_asset_id", "extraction_request_id", "source_sha256", "media_type", "raster_text_profile_revision"],
  "title": "Customs AI Agent raster text extraction binary request metadata",
  "type": "object"
}
