{
  "$defs": {
    "AuditEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "title": "Event",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "event",
        "message"
      ],
      "title": "AuditEvent",
      "type": "object"
    },
    "BBox": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "x1": {
          "minimum": 0,
          "title": "X1",
          "type": "number"
        },
        "x2": {
          "minimum": 0,
          "title": "X2",
          "type": "number"
        },
        "y1": {
          "minimum": 0,
          "title": "Y1",
          "type": "number"
        },
        "y2": {
          "minimum": 0,
          "title": "Y2",
          "type": "number"
        }
      },
      "required": [
        "page",
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BBox",
      "type": "object"
    },
    "EvidenceRetrievalRequest": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/RetrievalQueryItem"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "jurisdiction": {
          "const": "KR",
          "title": "Jurisdiction",
          "type": "string"
        },
        "query_intent": {
          "default": "required_import_documents",
          "maxLength": 2000,
          "minLength": 1,
          "title": "Query Intent",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "review_as_of": {
          "format": "date",
          "title": "Review As Of",
          "type": "string"
        },
        "review_run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Review Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "top_k": {
          "default": 8,
          "maximum": 100,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "trade_type": {
          "enum": [
            "import",
            "export"
          ],
          "title": "Trade Type",
          "type": "string"
        },
        "uploaded_requirement_document_codes": {
          "items": {
            "type": "string"
          },
          "title": "Uploaded Requirement Document Codes",
          "type": "array"
        },
        "validation_issue_codes": {
          "items": {
            "type": "string"
          },
          "title": "Validation Issue Codes",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "case_id",
        "review_run_id",
        "review_as_of",
        "jurisdiction",
        "trade_type",
        "items"
      ],
      "title": "EvidenceRetrievalRequest",
      "type": "object"
    },
    "ModelCallRecord": {
      "additionalProperties": false,
      "properties": {
        "cache_creation_input_tokens": {
          "minimum": 0,
          "title": "Cache Creation Input Tokens",
          "type": "integer"
        },
        "cache_read_input_tokens": {
          "minimum": 0,
          "title": "Cache Read Input Tokens",
          "type": "integer"
        },
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "message_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "model_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "prompt_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "provider": {
          "const": "anthropic",
          "title": "Provider",
          "type": "string"
        },
        "request_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "stop_reason": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Stop Reason",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "provider",
        "model_id",
        "prompt_id",
        "prompt_version",
        "request_id",
        "message_id",
        "stop_reason",
        "input_tokens",
        "output_tokens",
        "cache_creation_input_tokens",
        "cache_read_input_tokens",
        "latency_ms"
      ],
      "title": "ModelCallRecord",
      "type": "object"
    },
    "ModelErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "prompt_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Id"
        },
        "prompt_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "provider": {
          "anyOf": [
            {
              "const": "anthropic",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "provider_request_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Request Id"
        },
        "provider_status_code": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Status Code"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "document_id",
        "code",
        "retryable"
      ],
      "title": "ModelErrorDetail",
      "type": "object"
    },
    "RagEvidence": {
      "additionalProperties": false,
      "properties": {
        "agencies": {
          "items": {
            "type": "string"
          },
          "title": "Agencies",
          "type": "array"
        },
        "article_no": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Article No"
        },
        "eligibility": {
          "enum": [
            "finding",
            "supporting",
            "blocked"
          ],
          "title": "Eligibility",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^ev_[a-f0-9]{64}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "law_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Law Id"
        },
        "law_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Law Name"
        },
        "matched_hs_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Hs Code"
        },
        "raw_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Raw Scores",
          "type": "object"
        },
        "required_document_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Document Code"
        },
        "required_document_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Document Name"
        },
        "retrieval_methods": {
          "items": {
            "enum": [
              "exact_hs",
              "dense",
              "bm25",
              "graph"
            ],
            "type": "string"
          },
          "title": "Retrieval Methods",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "source_record_id": {
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "law_article",
            "customs_requirement",
            "hsk_entry",
            "notice"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "source_uri": {
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "trade_type": {
          "enum": [
            "import",
            "export"
          ],
          "title": "Trade Type",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "version_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Version Hash",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_record_id",
        "source_type",
        "item_id",
        "title",
        "text",
        "source_uri",
        "version_hash",
        "trade_type",
        "eligibility"
      ],
      "title": "RagEvidence",
      "type": "object"
    },
    "RegulatoryFinding": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "confidence_basis": {
          "default": "structured_requirement_policy",
          "enum": [
            "retrieval_score",
            "structured_requirement_policy"
          ],
          "title": "Confidence Basis",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "finding_code": {
          "title": "Finding Code",
          "type": "string"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "required_document_code": {
          "minLength": 1,
          "title": "Required Document Code",
          "type": "string"
        },
        "required_document_name": {
          "minLength": 1,
          "title": "Required Document Name",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "finding_code",
        "severity",
        "message",
        "item_id",
        "required_document_code",
        "required_document_name",
        "evidence_ids",
        "confidence"
      ],
      "title": "RegulatoryFinding",
      "type": "object"
    },
    "RetrievalErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "RetrievalErrorDetail",
      "type": "object"
    },
    "RetrievalItemResult": {
      "additionalProperties": false,
      "properties": {
        "candidate_hsk10s": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Hsk10S",
          "type": "array"
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/RetrievalErrorDetail"
          },
          "title": "Errors",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/RagEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "hs_resolution": {
          "enum": [
            "exact",
            "unique_descendant",
            "ambiguous",
            "invalid",
            "missing"
          ],
          "title": "Hs Resolution",
          "type": "string"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "requirements_found": {
          "title": "Requirements Found",
          "type": "boolean"
        },
        "resolved_hsk10": {
          "anyOf": [
            {
              "pattern": "^\\d{10}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Hsk10"
        }
      },
      "required": [
        "item_id",
        "hs_resolution",
        "coverage",
        "requirements_found"
      ],
      "title": "RetrievalItemResult",
      "type": "object"
    },
    "RetrievalQueryItem": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "destination_country": {
          "pattern": "^[A-Z]{2}$",
          "title": "Destination Country",
          "type": "string"
        },
        "hs_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hs Code"
        },
        "item_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "origin_country": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Country"
        }
      },
      "required": [
        "item_id",
        "description",
        "destination_country"
      ],
      "title": "RetrievalQueryItem",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "default": 0.95,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "confidence_basis": {
          "default": "deterministic_rule",
          "enum": [
            "deterministic_rule",
            "source_field_minimum"
          ],
          "title": "Confidence Basis",
          "type": "string"
        },
        "expected_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Value"
        },
        "issue_code": {
          "title": "Issue Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "needs_regulatory_review": {
          "default": false,
          "title": "Needs Regulatory Review",
          "type": "boolean"
        },
        "observed_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Value"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Document Id"
        },
        "target_bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Document Id"
        }
      },
      "required": [
        "issue_code",
        "severity",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    },
    "XaiReport": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "disclaimer": {
          "default": "This result is a pre-clearance review aid. Final legal decisions must be made by a responsible human reviewer.",
          "title": "Disclaimer",
          "type": "string"
        },
        "document_summary": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Document Summary",
          "type": "array"
        },
        "issues": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Issues",
          "type": "array"
        },
        "overall_status": {
          "enum": [
            "completed",
            "needs_review",
            "blocked"
          ],
          "title": "Overall Status",
          "type": "string"
        },
        "rag_evidence": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Rag Evidence",
          "type": "array"
        },
        "regulatory_findings": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Regulatory Findings",
          "type": "array"
        },
        "summary": {
          "additionalProperties": true,
          "title": "Summary",
          "type": "object"
        }
      },
      "required": [
        "case_id",
        "overall_status",
        "summary",
        "document_summary",
        "issues",
        "regulatory_findings",
        "rag_evidence"
      ],
      "title": "XaiReport",
      "type": "object"
    }
  },
  "$id": "https://schemas.customs.local/agent/v1/review-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Public, redacted Agent review result contract 1.0.",
  "properties": {
    "audit_trail": {
      "items": {
        "$ref": "#/$defs/AuditEvent"
      },
      "title": "Audit Trail",
      "type": "array"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "jurisdiction": {
      "title": "Jurisdiction",
      "type": "string"
    },
    "knowledge_snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Knowledge Snapshot Id"
    },
    "model_calls": {
      "items": {
        "$ref": "#/$defs/ModelCallRecord"
      },
      "title": "Model Calls",
      "type": "array"
    },
    "model_errors": {
      "items": {
        "$ref": "#/$defs/ModelErrorDetail"
      },
      "title": "Model Errors",
      "type": "array"
    },
    "rag_evidence": {
      "items": {
        "$ref": "#/$defs/RagEvidence"
      },
      "title": "Rag Evidence",
      "type": "array"
    },
