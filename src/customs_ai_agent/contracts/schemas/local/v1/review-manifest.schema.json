{
  "$defs": {
    "LocalManifestDocumentV1": {
      "additionalProperties": false,
      "properties": {
        "declared_type": {
          "anyOf": [
            {
              "enum": [
                "bill_of_lading",
                "invoice",
                "packing_list",
                "certificate_of_origin",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Type"
        },
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Document Id",
          "type": "string"
        },
        "filename": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "requirement_document_codes": {
          "items": {
            "type": "string"
          },
          "title": "Requirement Document Codes",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/LocalManifestSourceV1"
        }
      },
      "required": [
        "document_id",
        "filename",
        "source"
      ],
      "title": "LocalManifestDocumentV1",
      "type": "object"
    },
    "LocalManifestSourceV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "text",
            "image",
            "pdf"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ocr_ledger": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Ledger"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "LocalManifestSourceV1",
      "type": "object"
    }
  },
  "$id": "https://schemas.customs.local/agent/local/v1/review-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Local CLI file-adapter contract. Paths in this manifest never cross the Backend Agent request boundary.",
  "properties": {
    "case_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Id"
    },
    "contract_version": {
      "enum": [
        "v1",
        "v2"
      ],
      "title": "Contract Version",
      "type": "string"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/LocalManifestDocumentV1"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Documents",
      "type": "array"
    },
    "jurisdiction": {
      "const": "KR",
      "default": "KR",
      "title": "Jurisdiction",
      "type": "string"
    },
    "llm_mode": {
      "enum": [
        "mock",
        "llm"
      ],
      "title": "Llm Mode",
      "type": "string"
    },
    "review_as_of": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review As Of"
    },
    "review_run_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Run Id"
    },
    "schema_version": {
      "const": "customs-agent-local-review-manifest/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "trade_type": {
      "default": "import",
      "enum": [
        "import",
        "export"
      ],
      "title": "Trade Type",
      "type": "string"
    },
    "uploaded_requirement_document_codes": {
      "items": {
        "type": "string"
      },
      "title": "Uploaded Requirement Document Codes",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "contract_version",
    "llm_mode",
    "documents"
  ],
  "title": "Customs AI Agent local review manifest V1",
  "type": "object"
}
