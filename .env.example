# 실제 값은 저장소 안에 복사하지 않는다. 로컬에서는 개인 `_secrets/.env` 한 곳만
# 사용하고 CLI의 --env-file로 명시한다. 이 파일은 os.environ에 주입되지 않는다.
ANTHROPIC_API_KEY=

# 0.2.x 평가 기준은 Sonnet 5로 고정된다. 다른 모델은 새 평가/ADR 없이 허용하지 않는다.
CUSTOMS_AGENT_CLAUDE_MODEL=claude-sonnet-5
CUSTOMS_AGENT_CLAUDE_MAX_TOKENS=8192
CUSTOMS_AGENT_CLAUDE_TIMEOUT_SECONDS=90
CUSTOMS_AGENT_CLAUDE_MAX_RETRIES=2

# 설정하면 CLI는 실제 Evidence Service를 사용한다. --rag-url이 이 값보다 우선한다.
# HTTP는 localhost/loopback에서만 허용하고, 외부 주소는 HTTPS를 사용한다.
EVIDENCE_SERVICE_BASE_URL=http://127.0.0.1:8010
# 외부 HTTPS origin을 쓸 때만 정확한 origin을 comma-separated allowlist로 명시한다.
EVIDENCE_SERVICE_ALLOWED_ORIGINS=

# 운영 Data API와 맞춘 Bearer token이다. token을 URL이나 CLI 인자에 넣지 않는다.
# X-Demo-Token 같은 legacy header는 비운영 compatibility 실행에서만 명시적으로 사용한다.
EVIDENCE_SERVICE_TOKEN=
EVIDENCE_SERVICE_TOKEN_HEADER=Authorization

# 독립 Agent service를 실행할 때만 사용한다. `python -c
# "import secrets; print(secrets.token_urlsafe(32))"`처럼 최소 256-bit random token을
# 생성하고 저장소 밖 secret manager 또는 `_secrets/.env`에서 주입한다.
CUSTOMS_AGENT_SERVICE_BEARER_TOKEN=
CUSTOMS_AGENT_ENVIRONMENT=development
CUSTOMS_AGENT_BUILD_SHA=unknown
CUSTOMS_AGENT_WHEEL_SHA256=unknown
CUSTOMS_AGENT_HOST=127.0.0.1
CUSTOMS_AGENT_PORT=8080
CUSTOMS_AGENT_MAX_BODY_BYTES=2097152
CUSTOMS_AGENT_MAX_DOCUMENTS=6
CUSTOMS_AGENT_MAX_TEXT_CHARACTERS=500000
CUSTOMS_AGENT_BODY_READ_TIMEOUT_SECONDS=15
CUSTOMS_AGENT_MAX_CONCURRENCY=2
CUSTOMS_AGENT_QUEUE_WAIT_SECONDS=1
CUSTOMS_AGENT_RUN_TIMEOUT_SECONDS=420
CUSTOMS_AGENT_REPLAY_TTL_SECONDS=600
CUSTOMS_AGENT_REPLAY_MAX_ENTRIES=1000
CUSTOMS_AGENT_REPLAY_MAX_BYTES=67108864
CUSTOMS_AGENT_READINESS_TTL_SECONDS=5
CUSTOMS_AGENT_READINESS_TIMEOUT_SECONDS=5
CUSTOMS_AGENT_SHUTDOWN_GRACE_SECONDS=30
CUSTOMS_AGENT_LOG_LEVEL=INFO

# ANTHROPIC_BASE_URL, ANTHROPIC_CUSTOM_HEADERS, ANTHROPIC_AUTH_TOKEN,
# ANTHROPIC_LOG는 설정하지 않는다. endpoint/header override와 SDK debug log는 fail-closed된다.
